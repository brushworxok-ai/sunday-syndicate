# Vercel-managed Neon connection string (filled by `vercel env pull`).
DATABASE_URL=

# Create .env and paste your Google AI Studio key here.
GEMINI_API_KEY=your_api_key_here

# Optional overrides
GEMINI_MODEL=gemini-3.6-flash
ADMIN_PASSWORD=replace_with_a_long_unique_password
SESSION_SECRET=replace_with_at_least_32_random_characters

# Production messaging (not required by the deterministic demo adapter)
# SMS provider: "demo" (simulated), "textbelt" (easiest — one API key, pay per text
# at https://textbelt.com), or "twilio" (full-featured, needs an account).
SMS_PROVIDER=demo
# TEXTBELT_API_KEY=
DEMO_SMS_FAILURE_PLAYER_ID=player-jordan
APP_BASE_URL=https://your-domain.example

# Local-only overrides (uncomment when needed)
# PORT=8787
# DATABASE_PATH=work/sunday-syndicate.sqlite

# Optional Twilio production delivery (uncomment the values you configure)
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY=
# TWILIO_API_SECRET=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_STATUS_CALLBACK_URL=https://your-domain.example/api/webhooks/twilio/status
# TWILIO_INBOUND_WEBHOOK_URL=https://your-domain.example/api/webhooks/twilio/inbound
